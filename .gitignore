.env
# Backups of it too: this is a machine's own settings, never anyone else's.
.env.bak*
__pycache__/
*.pyc
.venv/

# **Internal documents: design notes, verification reports, this machine's setup.**
# These are deliberately not tracked. They are written in the author's language
# and carry the operator's environment and reasoning, which would mislead anyone
# reading them as documentation. See the language rules in CLAUDE.md.
docs/local/

# Compiled modules and their build directories are bound to one torch build.
native/o_voxel_cpu/build/
*.pyd
