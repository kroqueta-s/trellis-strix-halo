# TRELLIS runner configuration. Copy to .env (install.ps1 does this for you).
# Absolute paths only: the runner is started as a separate process.

TRELLIS_REPO=__REPO__
TRELLIS_WEIGHTS_DIR=__WEIGHTS__

# Sampler defaults (upstream pipeline.json uses 25 steps and cfg 5.0).
TRELLIS_SS_STEPS=25
TRELLIS_SLAT_STEPS=25
TRELLIS_SS_GUIDANCE=5.0
TRELLIS_SLAT_GUIDANCE=5.0

# Attention head chunk, used only when the fast attention path is unavailable.
TRELLIS_ATTN_HEAD_CHUNK=4

# Set TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 before torch is imported.
# Measured on gfx1151: flash/mem-efficient attention becomes available and
# attention is 10-20x faster. The flag has no effect if set after import.
TRELLIS_FAST_ATTENTION=on

# Prefer hipBLASLt over rocBLAS (set before torch is imported). Measured on
# gfx1151, ROCm 7.2.1: the sparse-conv shim's skinny GEMM goes from 1.0 to
# 14 TFLOPS and the slat stage from 52.4 s to 39.1 s. metrics.blas_backend
# records which backend was in effect.
TRELLIS_PREFER_HIPBLASLT=on

# Keep a hidden render loop alive while generating (gfxlight.py). Measured
# 2026-09-02: no effect in any state - with the display off the GPU pins at
# 600 MHz with the loop alive (see gfx1151-gemm docs/displayoff.md; keeping
# the display awake is what works). Kept only as an experiment switch.
# metrics.gfx_keepalive records whether it was alive.
TRELLIS_GFX_KEEPALIVE=on

# Hold the console display awake while generating (displaykeep.py). When the
# display turns off, the driver pins the GPU near 600 MHz and generation runs
# ~4x slower (gfx1151-gemm docs/displayoff.md). Off by default because it
# keeps the panel lit; turn it on for unattended runs on a machine whose
# display is allowed to sleep. metrics.display_keepalive records the hold.
TRELLIS_DISPLAY_KEEPALIVE=off

# Dedicated VRAM is 32 GB; torch.cuda.mem_get_info reports 43.87 GB because it
# includes shared memory. Without a cap, spilling into shared memory is silent
# and several times slower, so the limit is passed to torch as well.
TRELLIS_VRAM_LIMIT_GB=30
TRELLIS_HEARTBEAT_SEC=10

# Post-processing. Runs upstream's postprocess_mesh (visibility + min-cut),
# with the nvdiffrast rasterizer replaced by a torch one. Decimation is off:
# the mesh is an input for downstream scaling, not a textured GLB.
TRELLIS_FILL_HOLES=on
TRELLIS_FILL_HOLES_VIEWS=150
TRELLIS_FILL_HOLES_RESOLUTION=1024
TRELLIS_FILL_HOLES_MAX_SIZE=0.04
TRELLIS_FILL_HOLES_MAX_NBE=250

# Not in upstream: drop free-floating parts smaller than this fraction of the
# model's longest side. Upstream's visibility test cannot see them because they
# are visible. Set to 0 to keep everything.
TRELLIS_DROP_SMALL_PARTS=0.10

# Not in upstream: drop paper-thin flakes hovering on the surface (component
# min bbox extent / model longest side). Measured: flakes are <= 1.4 % thick,
# real detached parts >= 11.8 %. Set to 0 to keep everything.
TRELLIS_DROP_THIN_PARTS=0.02

# =====================================================================
# TRELLIS.2 (runners/trellis2) - **its own virtual environment**
# =====================================================================
# One model per environment, and their dependencies are pinned separately
# (requirements-trellis2.txt). See docs/trellis2.md for what every number
# below was measured on.

# The upstream checkout and the weights. `pipeline.local.json` sits beside the
# downloaded `pipeline.json` and names local files only: it drops the texture
# models and points the conditioner and the background remover at directories
# on this machine, so that **the downloaded description is never edited**.
TRELLIS2_REPO=__TRELLIS2_REPO__
TRELLIS2_WEIGHTS_DIR=__TRELLIS2_WEIGHTS__
TRELLIS2_PIPELINE_CONFIG=pipeline.local.json

# **Optional.** Where native\o_voxel_cpu\build.ps1 put the compiled
# mesh -> dual grid conversion (see native/o_voxel_cpu/README.md). Empty means
# it was not built; nothing on the image-to-mesh path needs it.
TRELLIS2_NATIVE_DIR=

# Output resolution. Measured on one image: 512 takes 49.6 s and 3.45 M faces,
# 1024 takes 209.3 s and 14.86 M faces, and asking for 1536 gets 1408 back -
# upstream's own token limit - for 1602.6 s and 26.24 M faces. **1024 is the
# operating point**: 1408 costs eight times the time for 1.8x the faces,
# because the shape stage is quadratic in the token count.
TRELLIS2_RESOLUTION=1024
TRELLIS2_MAX_TOKENS=49152

# Sampler settings. 0 means "whatever the checkpoint says" (12 steps,
# guidance 7.5).
TRELLIS2_SS_STEPS=0
TRELLIS2_SLAT_STEPS=0
TRELLIS2_SS_GUIDANCE=0
TRELLIS2_SLAT_GUIDANCE=0

# Carry the texture decoder's colours onto the vertices. **Not a texture map**:
# a vertex is interpolated from the voxels around it, so the colours survive
# decimation, hole closing and manifolding. It needs the texture checkpoints
# (install-trellis2.ps1 -WithTexture) and costs a second 1.3B flow.
# The texture flow has its own sampler settings; 0 means the checkpoint's own
# (12 steps, guidance 1.0).
TRELLIS2_VERTEX_COLORS=off
TRELLIS2_TEX_STEPS=0
TRELLIS2_TEX_GUIDANCE=0

# Unwrap the surface and bake the colours into a texture map as well. Unlike
# vertex colours the resolution is the texture's, not the mesh's, so detail
# finer than a triangle survives - but the atlas is bound to the vertices it
# was built for, so this produces a **second** mesh (extra.textured_glb) made
# before make_manifold rewrites them. What matters is texels per triangle:
# 2048 is 4.19 M texels, 2.8 per triangle on a 1.5 M-face mesh.
TRELLIS2_TEXTURE=off
TRELLIS2_TEXTURE_SIZE=2048
TRELLIS2_TEXTURE_DILATE=4

# Reduce to this many faces before unwrapping. The textured GLB is for looking
# at; mesh_path keeps every face. Measured: xatlas takes 13.0 s at 100k faces,
# 31.9 s at 200k, and was still running after ten minutes on the full 1.34 M.
# At 200k under a 2048 texture that is 21 texels per triangle, against 2.8 at
# 1.5 M - the atlas carries the detail, not the triangles. 0 keeps every face.
TRELLIS2_TEXTURE_TARGET_FACES=200000

# The charts are cut by direction in space, not by xatlas: asked to choose them
# itself it made 50,052 charts of five triangles from 200,000 faces, and no
# chart option moved that. Face normals are smoothed over the adjacency this
# many times before the direction is read off them (3 rounds put 64% of the
# faces in charts of fifty or more, 10 put 69%, 30 put 73%), and charts below
# the minimum are merged into a neighbour.
TRELLIS2_CHART_SMOOTHING=10
TRELLIS2_CHART_MIN_FACES=50

# Attention head chunk, used only when the fast attention path is unavailable.
TRELLIS2_ATTN_HEAD_CHUNK=4

# Set TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 before torch is imported.
# Measured on gfx1151 in **both fp16 and bf16**: flash runs 15x faster than the
# math backend and agrees with it to four decimals.
TRELLIS2_FAST_ATTENTION=on

# Prefer hipBLASLt over rocBLAS (also before torch is imported).
TRELLIS2_PREFER_HIPBLASLT=on

# Dedicated VRAM is 32 GB and `mem_get_info` reports 43.87 GB because it counts
# shared memory, so the limit is passed to torch as well. Measured peaks:
# 6.74 GB at 512, 15.42 GB at 1024, 28.40 GB at 1408.
TRELLIS2_VRAM_LIMIT_GB=30
TRELLIS2_HEARTBEAT_SEC=10

# --- Post-processing -------------------------------------------------
# Decimate to this many faces **before anything else**, because every stage
# after it costs in proportion to something it reduces: closing the holes takes
# 24.2 s on 3.45 M faces and 2.5 s on 700 k. Decimation itself costs 3.3 s and
# improves the topology on the way. 0 turns it off.
TRELLIS2_TARGET_FACES=1500000

# Drop free-floating debris: parts smaller than this fraction of the longest
# side, or thinner than the second one. Measured: 18,898 parts at 512 and
# 81,316 at 1024, worth 3.5-4.4 % of the faces.
TRELLIS2_DROP_SMALL_PARTS=0.10
TRELLIS2_DROP_THIN_PARTS=0.02

# Close the boundary loops, and how wide a loop may be before it is treated as
# an opening rather than a hole (a fraction of the longest side). **A fan over
# a wide loop is a sail, not a repair**: closing every loop covers 13.4 % of
# the surface area with patch, capping at 0.05 covers 3.3 %.
TRELLIS2_CLOSE_HOLES=on
TRELLIS2_CLOSE_MAX_EXTENT=0.05

# Make a printable solid out of the surface. **The decoder's output is a thin,
# incomplete, double-walled skin** (measured 2026-09-12), so sewing it shut
# encloses a tenth of the silhouette's volume. metrics.post.shell reports what
# the solid took and holds.
TRELLIS2_SHELL=on
# carve: keep the outer surface where it is and fill everything behind it (a
# corner is air only when it sees the outside in enough of 98 directions).
# band: every point within half a wall of the surface is solid, which grows
# the silhouette by half a wall and rounds off detail narrower than the wall.
TRELLIS2_SHELL_MODE=carve
# carve: rays out of 98 that must escape for a corner to be air. Measured 4:
# a deep bowl stays open up to 4 and fills from 6; the interior fills from 2.
TRELLIS2_SHELL_VISIBILITY=4
# band: the wall as a fraction of the longest side. The runner does not know
# millimetres: 0.0375 is 3 mm on an 80 mm print.
TRELLIS2_SHELL_THICKNESS=0.0375
# Cells along the longest side. 512 peaks at 2.5 GB of memory; 1024 is eight
# times that.
TRELLIS2_SHELL_GRID=512
# band: fill every enclosed pocket. carve always does.
TRELLIS2_SHELL_FILL_CAVITIES=on

# Separate the touching sheets, cut what cannot be oriented, close the seams.
# **This is what makes manifold3d - and so forge's repair_manifold - accept the
# mesh.** After the shell it only separates sheets that touch along an edge
# (measured 2026-09-12: nothing left to close). Without the shell it is not
# free: the seams cost patch worth 2.2-2.5x the input surface area, nearly all
# of it internal. Turn it off to get the model's own surface.
TRELLIS2_MAKE_MANIFOLD=on

# Normalizing the winding costs 270 s on a 3.45 M-face mesh against 49.6 s to
# generate it, so it is off: **do it downstream, after decimation**.
# `metrics.topology` reports the state either way.
TRELLIS2_FIX_WINDING=off

# Close the sparse region's edge during extraction. Measured: it changes almost
# nothing (830 faces of 3.45 M), because only ~415 quads are dropped for want
# of a neighbour. Kept as a switch because it costs nothing.
TRELLIS2_CLOSE_MESH=on
